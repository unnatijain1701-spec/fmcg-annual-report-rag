# Copy to .env and edit only if you need to. Defaults are in config.py.
OLLAMA_URL=http://localhost:11434
LLM_MODEL=gemma4:31b-cloud
SQL_MODEL=qwen2.5-coder:7b
EMBED_MODEL=bge-m3
# Model used to read financial tables into the numbers database (defaults to LLM_MODEL).
# If gemma4:31b-cloud returns malformed JSON, use the local SQL model instead:
# EXTRACT_MODEL=qwen2.5-coder:7b
# Use a Qdrant server instead of the embedded database (needed only if two processes must share it):
# QDRANT_URL=http://localhost:6333
# RERANK_MODEL=none        # skip the cross-encoder (debugging only)
# VERIFY=0                 # skip the faithfulness check
# TABLE_SUMMARY_MODE=llm   # one LLM call per table instead of rule-based summaries (very slow)
